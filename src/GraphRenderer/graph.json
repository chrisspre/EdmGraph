  "style": [
    {
      "selector": "node",
      "style": {
        "shape": "round-rectangle",
        "corner-radius": "20px",
        "color": "#000",
        "background-color": "#4a90e2",
        "label": "data(label)",
        "width": "5em",
        "text-valign": "center",
        "text-halign": "center"
      }
    },
    {
      "selector": "edge",
      "style": {
        "width": 3,
        "line-color": "#333",
        "target-arrow-shape": "triangle",
        "target-arrow-color": "#333",
        "label": "data(label)",
        "font-size": "12px",
        "color": "#333",
        "text-background-color": "#fff",
        "text-background-opacity": 0.8,
        "text-background-padding": "3px",
        "curve-style": "bezier"
      }
    }
  ],
  "layout": {
    "name": "breadthfirst",
    "animate": true,
    "animation-duration": 200,
    "animation-easing": "ease-in-out",
    "node-dimensions-include-labels": true,
    "spacing-factor": 1.75,
    "node-overlap": 10,
    "gravity": 0.9
  }
